msgstr "ElevenLabs کی طرف سے غیر متوقع جواب"

msgid "Credits used: {used} of {limit} ({percent}%)."
msgstr "استعمال شدہ کریڈٹس: {limit} میں سے {used} ({percent}%)۔"

